# ==============================================================================
# Camargo PMS — Plantilla de Configuración de Entorno (.env.example)
# ==============================================================================
# Copie este archivo como .env en su entorno local y configure sus valores.
# NUNCA guarde contraseñas ni secretos reales en este archivo versionado.
# ==============================================================================

# Entorno de la aplicación
APP_ENV=local
APP_DEBUG=true
APP_URL=https://app.camargo-pms.test
APP_TIMEZONE=America/Lima

# Base de datos (MySQL 8.4.3 LTS)
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=camargo_pms
DB_USERNAME=root
DB_PASSWORD=
DB_CHARSET=utf8mb4
DB_COLLATION=utf8mb4_0900_ai_ci
