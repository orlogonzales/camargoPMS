{
    "name": "camargohosteleria/camargo-pms",
    "description": "Camargo PMS — Sistema de Gestión Inmobiliaria y Turística",
    "type": "project",
    "license": "proprietary",
    "require": {
        "php": ">=8.3.0",
        "vlucas/phpdotenv": "^5.6"
    },
    "autoload": {
        "psr-4": {
            "CamargoPMS\\": "app/"
        },
        "files": [
            "app/Nucleo/Funciones.php"
        ]
    },
    "config": {
        "optimize-autoloader": true,
        "preferred-install": "dist",
        "sort-packages": true
    }
}
